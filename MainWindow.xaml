<Window x:Class="MusicPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:MusicPlayer.Converters"
        xmlns:icons="clr-namespace:MusicPlayer.Controls" Title="Music Player" Width="1200" Height="760" MinWidth="900"
        MinHeight="560" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        xmlns:views="clr-namespace:MusicPlayer.Views" xmlns:models="clr-namespace:MusicPlayer.Models">
    <Window.Resources>
        <DataTemplate x:Key="MusicBrowserPageTemplate">
            <views:MusicBrowserView />
        </DataTemplate>
        <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:views="clr-namespace:MusicPlayer.Views" x:Key="LibraryPageTemplate">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:views="clr-namespace:MusicPlayer.Views" x:Key="PlaylistsPageTemplate">
            <views:PlaylistsView />
        </DataTemplate>
        <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:views="clr-namespace:MusicPlayer.Views" x:Key="NowPlayingPageTemplate">
            <views:NowPlayingView />
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <Border x:Name="NotificationToast" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20,20,20,128" MaxWidth="420" Padding="14" CornerRadius="8"
                Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Visibility="{Binding HasToast, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissToastCommand}"
                        Style="{StaticResource QuietButton}" Margin="12,0,0,0" Width="26" Height="26" MinHeight="26"
                        Padding="0" AutomationProperties.Name="Dismiss notification" />
                <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <Grid x:Name="MainContent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImportingPlaylist}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsClearQueueConfirmationOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDeletePlaylistConfirmationOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="112" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="20,0">
                <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Center"
                        VerticalAlignment="Center" AutomationProperties.Name="Views">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppPage.Library}"
                                Style="{StaticResource LibraryNavigationButton}" AutomationProperties.Name="Library" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M 4,3 L 4,21 M 8,3 L 8,21 M 12,3 L 12,21 M 16,3 L 21,20" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Library" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppPage.Albums}"
                                Style="{StaticResource AlbumsNavigationButton}" AutomationProperties.Name="Albums" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12"
                                                  Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Albums" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppPage.Artists}"
                                Style="{StaticResource ArtistsNavigationButton}" AutomationProperties.Name="Artists" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M16 7 A4 4 0 1 1 8 7 A4 4 0 1 1 16 7 M4 21 L4 19 A6 6 0 0 1 10 13 L14 13 A6 6 0 0 1 20 19 L20 21"
                                                  Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Artists" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppPage.Playlists}"
                                Style="{StaticResource PlaylistsNavigationButton}" AutomationProperties.Name="Playlists" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M 4,6 L 4.01,6 M 9,6 L 21,6 M 4,12 L 4.01,12 M 9,12 L 21,12 M 4,18 L 4.01,18 M 9,18 L 21,18" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Playlists" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppPage.NowPlaying}"
                                Style="{StaticResource NowPlayingNavigationButton}" AutomationProperties.Name="Now Playing">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M 4,10 L 4,14 M 8,6 L 8,18 M 12,3 L 12,21 M 16,7 L 16,17 M 20,10 L 20,14" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Now Playing" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" x:Name="PageHost"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Content="{Binding}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource LibraryPageTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="Albums">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MusicBrowserPageTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="Artists">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MusicBrowserPageTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="Playlists">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PlaylistsPageTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="NowPlaying">
                                    <Setter Property="ContentTemplate" Value="{StaticResource NowPlayingPageTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <views:QueuePanel xmlns:views="clr-namespace:MusicPlayer.Views"
                                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Column="1"
                                  x:Name="QueueSidebar" Width="296"
                                  Visibility="{Binding IsQueueOpen, Converter={StaticResource BoolVisibility}}" />
            </Grid>
            <Border Grid.Row="3" Background="#382925" Padding="10" Margin="20,0,20,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlaybackError}" Value="{x:Null}" />
                                    <Condition Binding="{Binding PlaylistError}" Value="{x:Null}" />
                                    <Condition Binding="{Binding LocateStatus}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding PlaybackError}" Foreground="#F0B6A3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PlaylistError}" Foreground="#F0B6A3" TextWrapping="Wrap" />
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocateStatus}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissLocateStatusCommand}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding LocateStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Equal outer columns keep playback centered on the window, regardless of metadata. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" Background="#303238" BorderBrush="#41444A" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,12,0">
                            <Grid>
                                <icons:LucideIcon Geometry="{StaticResource IconMusic2}" Width="24" Height="24"
                                                  Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <Image
                                    Source="{Binding CurrentTrack.ArtworkData, Converter={StaticResource ByteArrayToImageConverter}}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding CurrentTrack.Title, TargetNullValue='Nothing playing', FallbackValue='Nothing playing'}"
                                FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentTrack.Title}" />
                            <TextBlock
                                Text="{Binding CurrentTrack.Artist, TargetNullValue='Unknown artist', FallbackValue=''}"
                                Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" x:Name="PlaybackCenter">
                        <StackPanel x:Name="TransportControls" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button x:Name="ShuffleButton" Command="{Binding ToggleShuffleCommand}"
                                    ToolTip="{Binding ShuffleLabel}" AutomationProperties.Name="{Binding ShuffleLabel}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="#D1E4F8" />
                                                <Setter Property="Background" Value="#33465B" />
                                                <Setter Property="BorderBrush" Value="#728FAE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <icons:LucideIcon Geometry="{StaticResource IconShuffle}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}"
                                    ToolTip="Previous song" AutomationProperties.Name="Previous song" Margin="0,0,8,0">
                                <icons:LucideIcon Geometry="{StaticResource IconSkipBack}" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Width="44"
                                    Height="44" Padding="0" Command="{Binding TogglePlaybackCommand}"
                                    ToolTip="{Binding PlayPauseLabel}"
                                    AutomationProperties.Name="{Binding PlayPauseLabel}">
                                <icons:LucideIcon Width="20" Height="20">
                                    <icons:LucideIcon.Style>
                                        <Style TargetType="icons:LucideIcon"
                                               BasedOn="{StaticResource {x:Type icons:LucideIcon}}">
                                            <Setter Property="Geometry" Value="{StaticResource IconPlay}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Geometry" Value="{StaticResource IconPause}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icons:LucideIcon.Style>
                                </icons:LucideIcon>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}"
                                    ToolTip="Next song" AutomationProperties.Name="Next song" Margin="8,0,0,0">
                                <icons:LucideIcon Geometry="{StaticResource IconSkipForward}" />
                            </Button>
                            <Button x:Name="RepeatButton" Command="{Binding CycleRepeatCommand}"
                                    ToolTip="{Binding RepeatLabel}" AutomationProperties.Name="{Binding RepeatLabel}"
                                    Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="#D1E4F8" />
                                                <Setter Property="Background" Value="#33465B" />
                                                <Setter Property="BorderBrush" Value="#728FAE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <icons:LucideIcon>
                                    <icons:LucideIcon.Style>
                                        <Style TargetType="icons:LucideIcon"
                                               BasedOn="{StaticResource {x:Type icons:LucideIcon}}">
                                            <Setter Property="Geometry" Value="{StaticResource IconRepeat}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRepeatOne}" Value="True">
                                                    <Setter Property="Geometry" Value="{StaticResource IconRepeat1}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icons:LucideIcon.Style>
                                </icons:LucideIcon>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleMuteCommand}" Margin="0,0,12,0"
                                MouseEnter="VolumeControl_MouseEnter" MouseLeave="VolumeControl_MouseLeave"
                                GotKeyboardFocus="VolumeControl_GotKeyboardFocus"
                                LostKeyboardFocus="VolumeControl_LostKeyboardFocus"
                                PreviewKeyDown="VolumeControl_PreviewKeyDown"
                                AutomationProperties.Name="{Binding MuteLabel}">
                            <icons:LucideIcon>
                                <icons:LucideIcon.Style>
                                    <Style TargetType="icons:LucideIcon" BasedOn="{StaticResource {x:Type icons:LucideIcon}}">
                                        <Setter Property="Geometry" Value="M 11,5 L 6,9 L 3,9 L 3,15 L 6,15 L 11,19 Z M 15,8 A 6,6 0 0 1 15,16 M 18,5 A 10,10 0 0 1 18,19" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Geometry" Value="M 11,5 L 6,9 L 3,9 L 3,15 L 6,15 L 11,19 Z M 16,9 L 22,15 M 22,9 L 16,15" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </icons:LucideIcon.Style>
                            </icons:LucideIcon>
                        </Button>
                        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=MuteButton}"
                               Placement="Top" HorizontalOffset="-15" VerticalOffset="-6"
                               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border x:Name="VolumePopupContent" Width="64" Padding="12,14" CornerRadius="8"
                                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" MouseEnter="VolumeControl_MouseEnter"
                                    MouseLeave="VolumeControl_MouseLeave"
                                    GotKeyboardFocus="VolumeControl_GotKeyboardFocus"
                                    LostKeyboardFocus="VolumeControl_LostKeyboardFocus"
                                    PreviewKeyDown="VolumeControl_PreviewKeyDown">
                                <StackPanel>
                                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                               Margin="0,0,0,10" />
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Orientation="Vertical"
                                            Height="120" Width="28" HorizontalAlignment="Center"
                                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                            AutomationProperties.Name="Volume" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="QueueToggle" Grid.Column="1" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding IsQueueOpen, Mode=TwoWay}"
                                      Style="{StaticResource QueueToggleButton}"
                                      ToolTip="{Binding QueueToggleLabel}"
                                      AutomationProperties.Name="{Binding QueueToggleLabel}">
                            <StackPanel Orientation="Horizontal">
                                <icons:LucideIcon Geometry="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 14,18"
                                                  Width="16" Height="16" Margin="0,0,7,0" />
                                <TextBlock Text="Queue" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock x:Name="QueueTrackCount" Text="{Binding Queue.Count, StringFormat='({0})'}" Margin="6,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsMoveToPointEnabled="True" AutomationProperties.Name="Playback position">
                            <Slider.Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTrack}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="ClearQueueDialog" Background="#99000000" Panel.ZIndex="10"
                Visibility="{Binding IsClearQueueConfirmationOpen, Converter={StaticResource BoolVisibility}}"
                IsVisibleChanged="ClearQueueDialog_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle">
            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelClearQueueCommand}" />
            </Border.InputBindings>
            <Border Width="400" Margin="24" Padding="24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    AutomationProperties.Name="Confirm clearing the queue">
                <StackPanel>
                    <TextBlock Text="Clear queue?" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClearQueueConfirmationMessage}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Your current song and played history will stay." Margin="0,8,0,24"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelClearQueueButton" Content="Cancel" Command="{Binding CancelClearQueueCommand}"
                                IsDefault="{Binding IsClearQueueConfirmationOpen}" Margin="0,0,8,0" />
                        <Button Content="Clear queue" Command="{Binding ConfirmClearQueueCommand}"
                                Style="{StaticResource DestructiveButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="DeletePlaylistDialog" Background="#99000000" Panel.ZIndex="10"
                Visibility="{Binding IsDeletePlaylistConfirmationOpen, Converter={StaticResource BoolVisibility}}"
                IsVisibleChanged="DeletePlaylistDialog_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle">
            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelDeletePlaylistCommand}" />
            </Border.InputBindings>
            <Border Width="400" Margin="24" Padding="24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    AutomationProperties.Name="Confirm deleting the playlist">
                <StackPanel>
                    <TextBlock Text="Delete playlist?" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlaylistPendingDeletion.Name}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeletePlaylistLibraryImpact}" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <CheckBox Content="Keep these songs in my library" IsChecked="{Binding KeepPlaylistSongsInLibrary}"
                              Margin="0,14,0,0" Visibility="{Binding HasPlaylistExclusiveSongs, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="Audio files on disk will not be deleted." Margin="0,10,0,20"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PlaylistDeletionError}" Foreground="#FFB4AB" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelDeletePlaylistButton" Content="Cancel" Command="{Binding CancelDeletePlaylistCommand}"
                                IsDefault="{Binding IsDeletePlaylistConfirmationOpen}" Margin="0,0,8,0" />
                        <Button Content="Delete playlist" Command="{Binding ConfirmDeletePlaylistCommand}"
                                Style="{StaticResource DestructiveButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="ImportProgressPanel" Background="#99000000" Panel.ZIndex="10"
                Visibility="{Binding IsImportingPlaylist, Converter={StaticResource BoolVisibility}}"
                IsVisibleChanged="ImportProgressPanel_IsVisibleChanged" Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding ImportProgressLabel}">
            <Border Width="440" Padding="28" CornerRadius="12" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Stroke="{StaticResource LineBrush}" StrokeThickness="4" />
                        <Path x:Name="ImportSpinner" Data="M 20,2 A 18,18 0 0 1 38,20"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Stretch="None">
                            <Path.RenderTransform>
                                <RotateTransform CenterX="20" CenterY="20" />
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportingPlaylist}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Spin">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.9"
                                                            RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="Spin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Text="{Binding ImportProgressLabel}" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ImportProgressDetail}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,10,0,0" />
                    <ProgressBar x:Name="PlaylistImportProgressBar" Height="5" Margin="0,20,0,0" Minimum="0"
                                 Maximum="100" Value="{Binding ImportProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsImportDiscovering}"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}"
                                 BorderThickness="0" AutomationProperties.Name="Playlist import progress" />
                </StackPanel>
