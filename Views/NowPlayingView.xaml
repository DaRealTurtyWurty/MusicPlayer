<UserControl x:Class="MusicPlayer.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:MusicPlayer.Controls">
    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Now Playing" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Grid Grid.Row="1" VerticalAlignment="Center" MaxHeight="320">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#25282D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MaxWidth="320"
                    MaxHeight="320" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                <Grid>
                    <icons:LucideIcon Geometry="{StaticResource IconMusic2}" Width="64" Height="64"
                                      Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <Image
                        Source="{Binding CurrentTrack.ArtworkData, Converter={StaticResource ByteArrayToImageConverter}}"
                        Stretch="Uniform" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding CurrentTrack.Title, FallbackValue='Nothing playing', TargetNullValue='Nothing playing'}"
                    FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='', TargetNullValue='Unknown artist'}"
                           FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentTrack.Album}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,18,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentTrack.DurationText}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0" />
                <Button Content="Go to Library" Command="{Binding NavigateCommand}" HorizontalAlignment="Left"
                        Margin="0,24,0,0">
                    <Button.CommandParameter>
                        <x:Static Member="models:AppPage.Library" xmlns:models="clr-namespace:MusicPlayer.Models" />
                    </Button.CommandParameter>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTrack}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
