<UserControl x:Class="MusicPlayer.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
   <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
   <TextBlock Text="Audio output" FontSize="18" Margin="0,0,0,12" />
   <ComboBox x:Name="AudioOutputSelector" Tag="No audio outputs available" ItemsSource="{Binding AudioOutputDevices}" DisplayMemberPath="Name"
             SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}" IsEnabled="{Binding CanSelectAudioOutput}"
             MinWidth="300" MaxWidth="600" HorizontalAlignment="Left" AutomationProperties.Name="Audio output device" />
   <TextBlock Text="{Binding AudioOutputMessage}" TextWrapping="Wrap" Margin="0,8,0,24" />
   <TextBlock Text="Playback" FontSize="18" Margin="0,0,0,12" />
   <CheckBox x:Name="GaplessPlaybackCheckBox" Content="Gapless playback" IsChecked="{Binding IsGaplessPlaybackEnabled, Mode=TwoWay}"
             AutomationProperties.Name="Gapless playback" />
   <TextBlock Text="Play consecutive tracks without a pause between them. Changes apply immediately."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" />
   <CheckBox x:Name="CrossfadeEnabledCheckBox" Content="Crossfade between tracks"
             IsChecked="{Binding IsCrossfadeEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable crossfade" />
   <StackPanel IsEnabled="{Binding IsCrossfadeEnabled}">
    <TextBlock Text="{Binding CrossfadeDurationSeconds, StringFormat='Crossfade duration: {0:0} seconds'}" Margin="0,12,0,6" />
    <Slider Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"
            Value="{Binding CrossfadeDurationSeconds, Mode=TwoWay}" AutomationProperties.Name="Crossfade duration in seconds" />
   </StackPanel>
   <TextBlock Text="Fade out the ending song while fading in the next queued song. Overrides gapless playback while enabled. Short songs use a shorter fade. Settings are saved automatically; changes apply during playback."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" />
   <TextBlock Text="ReplayGain" FontSize="18" Margin="0,0,0,12" />
   <CheckBox x:Name="ReplayGainEnabledCheckBox" Content="Normalize volume with ReplayGain"
             IsChecked="{Binding IsReplayGainEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable ReplayGain" />
   <TextBlock Text="Uses existing ReplayGain tags. Untagged songs keep their original level. Track mode balances individual songs; album mode preserves an album's volume differences, falling back to track gain when album gain is missing."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" />
   <StackPanel IsEnabled="{Binding IsReplayGainEnabled}">
    <Label Content="Gain mode" Target="{Binding ElementName=ReplayGainModeSelector}" Padding="0,0,0,6" />
    <ComboBox x:Name="ReplayGainModeSelector" ItemsSource="{Binding ReplayGainModes}" SelectedItem="{Binding SelectedReplayGainMode, Mode=TwoWay}"
              Width="180" HorizontalAlignment="Left" AutomationProperties.Name="ReplayGain mode" />
    <TextBlock Text="{Binding ReplayGainPreampDb, StringFormat='Preamp: {0:0.0} dB'}" Margin="0,12,0,6" />
    <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"
            Value="{Binding ReplayGainPreampDb, Mode=TwoWay}" AutomationProperties.Name="ReplayGain preamp in decibels" />
    <CheckBox Content="Prevent clipping" IsChecked="{Binding ReplayGainPreventClipping, Mode=TwoWay}" Margin="0,12,0,0" />
   </StackPanel>
   <TextBlock Text="Changes are saved automatically and apply to newly decoded audio, including the next gapless track. Clipping protection may reduce the requested boost."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" />
   <TextBlock Text="Discord presence" FontSize="18" Margin="0,0,0,12" />
   <TextBlock Text="Share your current song, artist, album, and playback time on your Discord profile. Presence clears when you pause or stop."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
   <CheckBox x:Name="EnabledCheckBox" Content="Show what I'm listening to" Margin="0,0,0,12" />
   <CheckBox x:Name="ArtworkCheckBox" Content="Look up album covers online" Margin="0,0,0,6" />
   <TextBlock Text="Uses MusicBrainz and Cover Art Archive while sharing. Sends album metadata, never your audio files or embedded images."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
   <Label Content="Application ID" Target="{Binding ElementName=ApplicationIdBox}" Padding="0,0,0,6" />
   <TextBox x:Name="ApplicationIdBox" MaxLength="20" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Discord application ID" />
   <TextBlock Text="The player's default application ID is included. You can replace it with your own. Discord desktop must be running with activity sharing enabled."
              TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" />
   <TextBlock Text="{Binding DiscordPresenceStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
   <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive" />
   <Button x:Name="SaveDiscordButton" Content="Save Discord settings" Click="SaveDiscord_Click" HorizontalAlignment="Left" Margin="0,0,0,24" />
   <TextBlock Text="Library scanning" FontSize="18" Margin="0,0,0,12" />
   <CheckBox Content="Automatically watch and scan for changes" IsChecked="{Binding AutomaticScanning}" />
   <TextBlock Text="Changes are checked after 1.5 seconds and reconciled every minute. Manual scans also reread tags." TextWrapping="Wrap" Margin="0,8,0,16" />
   <Button Content="Rescan library now" Command="{Binding RescanLibraryCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding LibraryRefreshStatus}" TextWrapping="Wrap" Margin="0,8,0,20" />
   <TextBlock Text="Watched folders" FontSize="18" Margin="0,0,0,8" />
   <TextBlock Text="Added folders discover music in all subfolders. Removing a folder keeps your songs, playlists and files. Known song files are still checked for changes when automatic scanning is enabled." TextWrapping="Wrap" Margin="0,0,0,12" />
   <ListBox ItemsSource="{Binding WatchedFolders}" SelectedItem="{Binding SelectedWatchedFolder}" MinHeight="100" MaxHeight="240" AutomationProperties.Name="Watched music folders">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
     <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
     <StackPanel Orientation="Horizontal"><TextBlock Text="Subfolders: " /><TextBlock Text="{Binding IncludeSubdirectories}" />
      <TextBlock Text="    Discover new songs: " /><TextBlock Text="{Binding DiscoverNewTracks}" /></StackPanel>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <WrapPanel Margin="0,12,0,0">
    <Button Content="Add folder..." Command="{Binding AddWatchedFolderCommand}" Margin="0,0,8,0" />
    <Button Content="Remove selected folder" Command="{Binding RemoveWatchedFolderCommand}" />
   </WrapPanel>
   <TextBlock Text="{Binding SettingsError}" Foreground="#FFB4AB" TextWrapping="Wrap" Margin="0,8,0,0" />
   <TextBlock Text="{Binding LibraryError}" Foreground="#FFB4AB" TextWrapping="Wrap" />
   <TextBlock Text="Library backup and diagnostics" FontSize="18" Margin="0,24,0,12" />
   <TextBlock Text="A library snapshot is saved at startup and before database upgrades. Backups contain the library, playlists and playback session; keep a separate backup of your music files." TextWrapping="Wrap" Margin="0,0,0,12" />
   <Button Content="Back up library now" Click="BackupLibrary_Click" HorizontalAlignment="Left" />
   <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
