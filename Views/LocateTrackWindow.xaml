<Window x:Class="MusicPlayer.Views.LocateTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locate song" Width="720" Height="460" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Several files match this song" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SongDescription" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Choose the file to use. Your playlists and queue will keep this song." Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <ListBox x:Name="Matches" Grid.Row="1" SelectionChanged="Matches_SelectionChanged"
                 MouseDoubleClick="Matches_MouseDoubleClick" AutomationProperties.Name="Matching music files">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6">
                        <DockPanel>
                            <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding Album, TargetNullValue=Unknown album}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding FilePath}" ToolTip="{Binding FilePath}" Margin="0,5,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="UseFileButton" Content="Use this file" IsDefault="True" IsEnabled="False" Click="UseFile_Click" />
        </StackPanel>
    </Grid>
</Window>
