<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicPlayer.Views.QueuePanel">
    <UserControl.Resources>
        <ContextMenu x:Key="QueueContextMenu" x:Shared="False" FontSize="12" FontWeight="Normal"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Play" Command="{Binding PlayQueueEntryCommand}" InputGestureText="Enter" />
            <MenuItem Header="_Remove" Command="{Binding RemoveFromQueueCommand}" InputGestureText="Delete" />
            <Separator />
            <MenuItem Header="Move _up" Command="{Binding MoveQueueUpCommand}" InputGestureText="Alt+Up" />
            <MenuItem Header="Move _down" Command="{Binding MoveQueueDownCommand}" InputGestureText="Alt+Down" />
            <Separator />
            <MenuItem Header="Play _next" Command="{Binding PlayTrackNextCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Add to _queue" Command="{Binding EnqueueTrackCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Add to _playlist…" Click="AddToPlaylist_Click"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Show _album" Command="{Binding ShowAlbumCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Show a_rtist" Command="{Binding ShowArtistCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Open file _location" Command="{Binding OpenFileLocationCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="_Locate"
                      Visibility="{Binding PlacementTarget.DataContext.Track.IsMissing, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolVisibility}}">
                <MenuItem Header="Choose _file…" Command="{Binding LocateFileCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Search _folder…" Command="{Binding LocateFolderCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext.Track, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
            Padding="16,0,16,16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Queue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearQueueCommand}"
                        VerticalAlignment="Center" ToolTip="Clear upcoming tracks" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="9,0" />
            </Border>
            <Grid Grid.Row="2">
                <ListBox x:Name="QueueList" ItemsSource="{Binding QueueTimeline}"
                         SelectedItem="{Binding SelectedQueueEntry, Mode=TwoWay}" SelectionMode="Single"
                         MouseDoubleClick="QueueList_MouseDoubleClick"
                         AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="QueueList_PreviewMouseMove" PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp"
                         DragOver="QueueList_DragOver" DragLeave="QueueList_DragLeave" Drop="QueueList_Drop"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveFromQueueCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding PlayQueueEntryCommand}" />
                        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveQueueUpCommand}" />
                        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveQueueDownCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ContextMenu" Value="{StaticResource QueueContextMenu}" />
                            <EventSetter Event="ContextMenuOpening" Handler="QueueEntry_ContextMenuOpening" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="EntryRow" Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="EntryStatus" Text="{Binding Status}" FontSize="10"
                                               Visibility="Collapsed"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3" />
                                    <DockPanel>
                                        <TextBlock Text="Missing" DockPanel.Dock="Right" Foreground="#FFB4AB" FontSize="10"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding Track.IsMissing, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock x:Name="EntryTitle" Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Track.Title}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Track.Artist, TargetNullValue=Unknown artist}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Track.DurationText}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                    <Setter TargetName="EntryRow" Property="Height" Value="64" />
                                    <Setter TargetName="EntryStatus" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHistory}" Value="True">
                                    <Setter TargetName="EntryRow" Property="Opacity" Value="0.65" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="EntryTitle" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="EntryTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="EntryStatus" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="DropIndicator" Height="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Top" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DropIndicatorPosition" />
                    </Border.RenderTransform>
                </Border>
                <TextBlock Text="Queue is empty" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsQueueTimelineEmpty, Converter={StaticResource BoolVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
