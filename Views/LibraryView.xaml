<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:MusicPlayer.Controls"
             x:Class="MusicPlayer.Views.LibraryView" SizeChanged="LibraryView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="AlbumColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="1.5*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlbumText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="TrackContextMenu" x:Shared="False" FontSize="12" FontWeight="Normal"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Add to _queue" Click="AddToQueue_Click" />
            <MenuItem Header="Play _next" Click="PlayNext_Click" />
            <Separator />
            <MenuItem Header="Add to _playlist…" Click="AddToPlaylist_Click" />
            <Separator />
            <MenuItem Header="Show _album" Command="{Binding PlacementTarget.Tag.ShowAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Show a_rtist" Command="{Binding PlacementTarget.Tag.ShowArtistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Open file _location" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="_Locate" Visibility="{Binding IsMissing, Converter={StaticResource BoolVisibility}}">
                <MenuItem Header="Choose _file…" Command="{Binding PlacementTarget.Tag.LocateFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="Search _folder…" Command="{Binding PlacementTarget.Tag.LocateFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}" />
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="AddMusicMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Choose _files…" Command="{Binding AddMusicFilesCommand}" />
            <MenuItem Header="Choose a _folder…" Command="{Binding AddMusicFolderCommand}" />
            <Separator />
            <MenuItem Header="_Rescan library" Command="{Binding RescanLibraryCommand}" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="20,0,20,16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Library" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} tracks}"
                           Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add music…" Click="AddMusic_Click" ContextMenu="{StaticResource AddMusicMenu}"
                        Margin="0,0,8,0" />
                <Button Content="Play all" Command="{Binding PlayAllCommand}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        ToolTip="Replace the queue and play the visible library tracks">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <WrapPanel>
                <Grid MaxWidth="300" HorizontalAlignment="Left" Width="300" Margin="0,0,16,0">
                    <TextBox x:Name="LibrarySearch" FontSize="12" Padding="30,5,30,5"
                             Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search library" ToolTip="Search titles, artists, and albums"
                             PreviewKeyDown="LibrarySearch_PreviewKeyDown" />
                    <icons:LucideIcon Geometry="M21 21 L16.65 16.65 M19 11 A8 8 0 1 1 3 11 A8 8 0 1 1 19 11"
                                      Width="14" Height="14" Foreground="{StaticResource MutedBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="Search library" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="31,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="×" Command="{Binding ClearLibrarySearchCommand}" Width="26" Height="26"
                            MinHeight="26" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear library search">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <CheckBox Content="Not in a playlist" IsChecked="{Binding ShowUncategorizedTracks}"
                          VerticalAlignment="Center" Margin="0,6,0,6" />
            </WrapPanel>
            <TextBlock Text="{Binding LibraryError}" TextWrapping="Wrap" Foreground="#FFB4AB" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,8,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LibraryError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="2" Background="#05FFFFFF" BorderBrush="#28383838" BorderThickness="0,0,0,1">
            <!-- Insets match the item border/padding and the reserved scrollbar gutter. -->
            <Grid x:Name="LibraryColumns" Margin="9,0,21,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Style="{StaticResource AlbumColumn}" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleHeader" Text="Title" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ArtistHeader" Grid.Column="1" Text="Artist" Style="{StaticResource Caption}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AlbumHeader" Grid.Column="2" Text="Album" Style="{StaticResource AlbumText}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Duration" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <ListView x:Name="TrackList" ItemsSource="{Binding LibraryTracks}"
                      SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" SelectionMode="Single"
                      MouseDoubleClick="TrackList_MouseDoubleClick"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                <ListView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PlaySelectedTrackCommand}" />
                </ListView.InputBindings>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <EventSetter Event="ContextMenuOpening" Handler="Track_ContextMenuOpening" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource TrackContextMenu}" />
                        <Setter Property="Padding" Value="8,7" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Style="{StaticResource AlbumColumn}" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="Missing" DockPanel.Dock="Right" Foreground="#FFB4AB" FontSize="10"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           ToolTip="File unavailable. Right-click and choose Locate."
                                           Visibility="{Binding IsMissing, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock x:Name="TrackTitle" Text="{Binding Title}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </DockPanel>
                            <TextBlock x:Name="TrackArtist" Grid.Column="1" Text="{Binding Artist, TargetNullValue=—}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="TrackAlbum" Grid.Column="2" Text="{Binding Album, TargetNullValue=—}"
                                       Style="{StaticResource AlbumText}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,8,0"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <Button Grid.Column="4" Content="⋯" Style="{StaticResource QuietButton}"
                                    Width="28" Height="28" MinHeight="28" Padding="0" Margin="8,0,0,0"
                                    FontSize="18" Click="TrackActions_Click"
                                    PreviewMouseDoubleClick="TrackActions_PreviewMouseDoubleClick"
                                    ToolTip="Track actions (right-click or Shift+F10)"
                                    AutomationProperties.Name="{Binding Title, StringFormat=Actions for {0}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LibraryTracks.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tracks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="No matching tracks" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Try another search or clear your filters." Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,12" TextAlignment="Center" />
                <Button Content="Clear filters" Command="{Binding ClearLibraryFiltersCommand}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tracks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Your library is empty" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Music you add or import through playlists appears here." Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Add music…" Click="AddMusic_Click" ContextMenu="{StaticResource AddMusicMenu}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
