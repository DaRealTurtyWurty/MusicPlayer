<UserControl x:Class="MusicPlayer.Views.MusicBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:MusicPlayer.Controls">
    <UserControl.Resources>
        <ContextMenu x:Key="BrowseTrackMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Play" Command="{Binding PlayBrowseTrackCommand}" />
            <MenuItem Header="Play _next" Command="{Binding PlayTrackNextCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Add to _queue" Command="{Binding EnqueueTrackCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Add to _playlist…" Click="AddToPlaylist_Click"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Show _album" Command="{Binding ShowAlbumCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Show a_rtist" Command="{Binding ShowArtistCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Open file _location" Command="{Binding OpenFileLocationCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="_Locate" Visibility="{Binding SelectedBrowseTrack.IsMissing, Converter={StaticResource BoolVisibility}}">
                <MenuItem Header="Choose _file…" Command="{Binding LocateFileCommand}" CommandParameter="{Binding SelectedBrowseTrack}" />
                <MenuItem Header="Search _folder…" Command="{Binding LocateFolderCommand}" CommandParameter="{Binding SelectedBrowseTrack}" />
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="20,0,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel VerticalAlignment="Center">
            <Button Command="{Binding CloseMusicGroupCommand}" MaxWidth="280" ToolTip="{Binding MusicBackLabel}"
                    Visibility="{Binding HasBrowseSelection, Converter={StaticResource BoolVisibility}}"
                    Style="{StaticResource QuietButton}" Margin="0,0,12,0">
                <TextBlock Text="{Binding MusicBackLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <TextBlock Text="{Binding MusicBrowserHeading}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding ReleaseTypeError}" Foreground="#FFB4AB" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ReleaseTypeError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Grid x:Name="MusicGroupHeader" Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding HasBrowseSelection, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <icons:PlaylistCover Tracks="{Binding BrowseSelection.Tracks}" Width="88" Height="88"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding BrowseSelection.Name}" FontSize="23" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding BrowseSelection.Name}" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding BrowseSelection.Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding BrowseSelection.DurationSummary}" Foreground="{StaticResource MutedBrush}" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding BrowseSelection.IsRelease, Converter={StaticResource BoolVisibility}}">
                    <Border Background="#344353" CornerRadius="4" Padding="7,3" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="{Binding BrowseSelection.ReleaseTypeHint}">
                        <TextBlock Text="{Binding BrowseSelection.ReleaseTypeLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                    </Border>
                    <ComboBox x:Name="ReleaseTypeEditor" ItemsSource="{Binding ReleaseTypeChoices}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedReleaseTypeChoice, Mode=TwoWay}" Width="155" MinHeight="30"
                              IsEnabled="{Binding CanEditReleaseType}" AutomationProperties.Name="Release type"
                              ToolTip="Classify this release. Saved in your library without changing the music files." />
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Command="{Binding PlayMusicGroupCommand}" Style="{StaticResource PrimaryButton}"
                            ToolTip="Play all tracks and replace the queue" MinWidth="70" Margin="0,0,8,4">
                        <TextBlock Text="Play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Content="Add to queue" Command="{Binding QueueMusicGroupCommand}" Margin="0,0,8,4" />
                    <Button Content="{Binding ArtistTracksToggleLabel}" Command="{Binding ToggleArtistTracksCommand}"
                            Visibility="{Binding IsArtistDetail, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="MusicGallery" Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowBrowseTracks}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <Grid MaxWidth="340" HorizontalAlignment="Left" Width="240">
                    <TextBox x:Name="MusicSearch" Text="{Binding MusicSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding MusicSearchPlaceholder}" ToolTip="{Binding MusicSearchPlaceholder}"
                             PreviewKeyDown="MusicSearch_PreviewKeyDown" />
                    <TextBlock Text="{Binding MusicSearchPlaceholder}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MusicSearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding ShowReleaseFilters, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Release type" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="ReleaseTypeFilter" ItemsSource="{Binding ReleaseFilters}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedReleaseFilter, Mode=TwoWay}" Width="160" MinHeight="30"
                              AutomationProperties.Name="Filter release type" />
                </StackPanel>
            </StackPanel>
                <ItemsControl x:Name="MusicTiles" Grid.Row="1" Style="{StaticResource VirtualizedGallery}" ItemsSource="{Binding VisibleMusicGroups}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><icons:VirtualizingTilePanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenMusicGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}"
                                    Width="172" Margin="0,0,12,14" Padding="10" Background="Transparent" BorderBrush="Transparent"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                <StackPanel>
                                    <icons:PlaylistCover Tracks="{Binding Tracks}" Height="150" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                    <Border Background="#344353" CornerRadius="4" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Visibility="{Binding IsRelease, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ReleaseTypeHint}">
                                        <TextBlock Text="{Binding ReleaseTypeLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VisibleMusicGroups.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <icons:LucideIcon Geometry="{StaticResource IconMusic2}" Width="32" Height="32" Margin="0,0,0,16"
                                  Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding MusicEmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="MusicTrackDetail" Grid.Row="3" Visibility="{Binding ShowBrowseTracks, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="8,0,12,0">
                <TextBlock DockPanel.Dock="Right" Text="Duration" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="Tracks" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
            <ListView x:Name="MusicTrackList" Grid.Row="1" ItemsSource="{Binding BrowseTracks}"
                      SelectedItem="{Binding SelectedBrowseTrack, Mode=TwoWay}" SelectionMode="Single"
                      MouseDoubleClick="MusicTrackList_MouseDoubleClick">
                <ListView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PlayBrowseTrackCommand}" />
                </ListView.InputBindings>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Padding" Value="8,7" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource BrowseTrackMenu}" />
                        <EventSetter Event="ContextMenuOpening" Handler="Track_ContextMenuOpening" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Missing" Foreground="#FFB4AB" Margin="8,0,8,0"
                                               Visibility="{Binding IsMissing, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                </DockPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Artist" /><Binding Path="Album" /></MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="⋯" Style="{StaticResource QuietButton}" Width="28" MinHeight="26"
                                    Padding="0" Margin="4,0,0,0" Click="TrackActions_Click" PreviewMouseDoubleClick="TrackActions_PreviewMouseDoubleClick"
                                    AutomationProperties.Name="Track actions" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
