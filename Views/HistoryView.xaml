<UserControl x:Class="MusicPlayer.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshListeningHistoryCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Listening history" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Your latest 500 plays. A play is counted when playback starts; pause and resume count once."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,12,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding ListeningHistoryError}" Foreground="#F0B6A3" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Grid Grid.Row="2">
            <ListView x:Name="HistoryList" ItemsSource="{Binding ListeningHistory}" MouseDoubleClick="HistoryList_MouseDoubleClick"
                      AutomationProperties.Name="Listening history" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PlayHistoryEntryCommand}" CommandParameter="{Binding SelectedItem, ElementName=HistoryList}" />
                </ListView.InputBindings>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Track.Artist, TargetNullValue=Unknown artist}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PlayedAtText}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" ToolTip="Played at (local time)" />
                            <TextBlock Grid.Column="2" Text="{Binding Track.PlayCountText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Button Grid.Column="3" Content="Play" Command="{Binding DataContext.PlayHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Track.Title, StringFormat=Play {0}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Your listening history will appear here when you play a song." TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ListeningHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
