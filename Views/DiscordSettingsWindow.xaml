<Window x:Class="MusicPlayer.Views.DiscordSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord presence" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock Text="Discord presence" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Share your current song, artist, album, and playback time on your Discord profile. Presence clears when you pause or stop."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20" />
        <CheckBox x:Name="EnabledCheckBox" Content="Show what I’m listening to" Margin="0,0,0,20" />
        <CheckBox x:Name="ArtworkCheckBox" Content="Look up album covers online" Margin="0,0,0,6" />
        <TextBlock Text="Uses MusicBrainz and Cover Art Archive while sharing. Sends album metadata, never your audio files or embedded images."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
        <Label Content="Application ID" Target="{Binding ElementName=ApplicationIdBox}" Padding="0,0,0,6" />
        <TextBox x:Name="ApplicationIdBox" MaxLength="20" AutomationProperties.Name="Discord application ID" />
        <TextBlock Text="The player’s default application ID is included. You can replace it with your own. Discord desktop must be running with activity sharing enabled."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" />
        <TextBlock Text="{Binding DiscordPresenceStatus}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" />
        <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
