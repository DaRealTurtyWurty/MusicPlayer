<Window x:Class="MusicPlayer.Views.PlaylistPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to playlist" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock Text="Add to playlist" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="TrackTitle" Margin="0,8,0,20" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource MutedBrush}" />
        <ListBox x:Name="DestinationList" ItemsSource="{Binding Playlists}" DisplayMemberPath="Name"
                 MinHeight="120" MaxHeight="240" IsEnabled="{Binding CanChoosePlaylist}"
                 AutomationProperties.Name="Destination playlist" />
        <TextBlock Text="No playlists yet. Create one in Playlists, then add this track."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Playlists.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding PlaylistError}" TextWrapping="Wrap" Foreground="#F0B6A3"
                   Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Add" IsDefault="True" Click="Add_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=DestinationList}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanChoosePlaylist}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
