<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\Lucide\LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Compile Remove="Tests\**\*.cs" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <Page Remove="Tests\**\*.xaml" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="NAudio" Version="3.1.0" />
        <PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
        <PackageReference Include="TagLibSharp" Version="2.3.0" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
        <Content Include="Native\sndfile.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>sndfile.dll</TargetPath>
        </Content>
    </ItemGroup>

</Project>
