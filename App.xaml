<Application x:Class="MusicPlayer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ThemeMode="Dark"
             xmlns:icons="clr-namespace:MusicPlayer.Controls" xmlns:converters="clr-namespace:MusicPlayer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Lucide/Icons.xaml" />
                <ResourceDictionary Source="Themes/PlayerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style TargetType="icons:LucideIcon">
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue=#CDD1D6}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>