<UserControl x:Class="MusicPlayer.Controls.PlaylistCover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:MusicPlayer.Controls"
             Focusable="False" IsHitTestVisible="False">
    <Grid Background="#292C30" ClipToBounds="True">
        <icons:LucideIcon Geometry="{StaticResource IconMusic2}" Width="36" Height="36"
                          Foreground="#888E96" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ItemsControl x:Name="CoverImages">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <icons:PlaylistCoverPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="#292C30" ClipToBounds="True">
                        <icons:LucideIcon Geometry="{StaticResource IconMusic2}" Width="24" Height="24"
                                          Foreground="#888E96" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding}" Stretch="UniformToFill" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>