<UserControl x:Class="MusicPlayer.Controls.ArtistArtwork"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Background="#292C30" ClipToBounds="True">
        <Viewbox Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="40" Height="40">
                <Ellipse Width="13" Height="13" Canvas.Left="13.5" Canvas.Top="3" Stroke="#888E96" StrokeThickness="2" />
                <Path Data="M 6,37 L 6,31 C 6,20 34,20 34,31 L 34,37" Stroke="#888E96" StrokeThickness="2" />
            </Canvas>
        </Viewbox>
        <Image x:Name="PhotoImage" Stretch="UniformToFill" />
    </Grid>
</UserControl>
